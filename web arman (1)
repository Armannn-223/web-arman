@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; scroll-behavior: smooth; }

body { font-family: Arial, sans-serif; background: rgb(16, 16, 16); color: white; }

header { background: rgb(23, 23, 23); padding: 18px 25px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0px; z-index: 100; border-bottom: 2px solid rgb(255, 189, 36); }

.logo { font-size: 21px; font-weight: bold; color: rgb(255, 189, 36); }

nav { display: flex; gap: 15px; }

nav a { color: white; text-decoration: none; font-size: 12px; }

nav a:hover { color: rgb(255, 189, 36); }

.hero { min-height: 450px; padding: 70px 20px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.85)), url("https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=1200") center center / cover; }

.hero h1 { color: rgb(255, 189, 36); font-size: 45px; margin-bottom: 15px; }

.hero h3 { margin-bottom: 15px; }

.hero p { max-width: 650px; line-height: 1.8; color: rgb(221, 221, 221); }

.btn { display: inline-block; background: rgb(255, 189, 36); color: black; padding: 14px 25px; text-decoration: none; font-weight: bold; border-radius: 5px; margin-top: 25px; }

section { padding: 55px 20px; }

h2 { text-align: center; color: rgb(255, 189, 36); font-size: 27px; margin-bottom: 30px; }

.description { max-width: 850px; margin: auto; text-align: center; color: rgb(204, 204, 204); line-height: 1.9; }

.history { background: rgb(25, 25, 25); }

.history-box { max-width: 850px; margin: auto; background: rgb(34, 34, 34); border-left: 5px solid rgb(255, 189, 36); padding: 25px; border-radius: 8px; }

.history-box p { color: rgb(204, 204, 204); line-height: 1.9; }

.steps { max-width: 850px; margin: auto; }

